{
    "name": "netforge-admin-client",
    "version": "0.0.0",
    "engines": {
        "node": "26.12.1"
    },
    "engineStrict": true,
    "volta": {
        "node": "26.12.1"
    },
    "scripts": {
        "start": "cross-env NG_APP_ENV=development NG_APP_USE_PROXY=true ng serve --project web",
        "build": "ng build --project web",
        "build:dev": "cross-env NG_APP_ENV=development npm run build -- --configuration development",
        "build:prod": "cross-env NG_APP_ENV=production npm run build -- --configuration production",
        "test": "cross-env NODE_OPTIONS=--no-webstorage ng test --no-watch --reporters=default ",
        "test:browser": "ng test --no-watch --reporters=default --browsers=chromium",
        "lint": "npm run eslint && npm run stylelint",
        "lint:fix": "npm run eslint:fix && npm run stylelint:fix",
        "prepare": "husky",
        "eslint": "eslint --cache \"projects/**/*.{ts,html}\"",
        "eslint:fix": "npm run eslint -- --fix",
        "stylelint": "stylelint --cache \"projects/**/*.*css\"",
        "stylelint:fix": "npm run stylelint -- --fix"
    },
    "private": true,
    "type": "module",
    "dependencies": {
        "@angular/cdk": "^22.2.4",
        "@angular/common": "^22.2.3",
        "@angular/compiler": "^22.2.3",
        "@angular/core": "^22.2.3",
        "@angular/forms": "^22.2.3",
        "@angular/material": "^22.2.4",
        "@angular/material-luxon-adapter": "^22.2.4",
        "@angular/platform-browser": "^22.2.3",
        "@angular/router": "^22.2.3",
        "luxon": "^3.7.2",
        "ngxtension": "^7.3.1",
        "rxjs": "~7.8.2",
        "tslib": "^2.8.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@angular/build": "^22.2.4",
        "@angular/cli": "^22.2.4",
        "@angular/compiler-cli": "^22.2.3",
        "@ngx-env/builder": "^22.0.0",
        "@saritasa-nest/eslint-config-angular": "^2.1.0",
        "@stylistic/stylelint-plugin": "^5.3.1",
        "@types/luxon": "^3.7.6",
        "@vitest/browser-playwright": "^5.0.5",
        "cross-env": "^10.1.0",
        "eslint": "^10.13.0",
        "eslint-plugin-format": "^2.0.1",
        "husky": "^9.1.7",
        "jsdom": "^30.1.3",
        "lint-staged": "^17.6.0",
        "stylelint": "^17.16.0",
        "stylelint-config-idiomatic-order": "^10.0.0",
        "stylelint-config-recommended-scss": "^17.0.1",
        "stylelint-config-standard": "^40.0.0",
        "type-fest": "^5.10.0",
        "typescript": "^6.0.3",
        "vitest": "^5.0.5"
    },
    "lint-staged": {
        "projects/**/*.{ts,html}": "eslint --cache --fix",
        "projects/**/*.*css": "stylelint --cache --fix"
    }
}
